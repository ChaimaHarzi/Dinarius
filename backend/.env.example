# --- Server -------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Public URL of this API (used for OAuth callbacks)
API_URL=http://localhost:5000
# Frontend origin(s), comma separated (CORS + links in emails)
CLIENT_URL=http://localhost:4200

# --- Database -----------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/dinarius

# --- Auth ---------------------------------------------------------------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Optional: Google sign-in (leave empty to disable the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments -----------------------------------------------------------
# Optional: without a key the API runs in "demo payment" mode
# (contributions are marked as paid instantly, no card required).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email --------------------------------------------------------------
# Optional: without SMTP settings emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dinarius <no-reply@dinarius.dev>"
